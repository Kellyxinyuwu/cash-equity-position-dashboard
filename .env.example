# Tiingo token. Copy this file to .env. Never commit .env.
MARKET_DATA_API_KEY=

# Local Ollama. No OpenAI key. `ollama serve` must be running, and the model
# name must be one you already pulled (`ollama list`).
MODEL_API_KEY=
MODEL_NAME=llama3.2:latest
MODEL_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions

# Shared desk password for the page. Leave this blank to leave the page open.
# The React screen asks for it before it reads the book.
BOOK_PASSWORD=

# To use OpenAI instead, set a real key and:
# MODEL_NAME=gpt-4o-mini
# MODEL_CHAT_URL=https://api.openai.com/v1/chat/completions
